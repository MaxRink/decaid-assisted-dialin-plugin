{$RESEARCH_DOMAIN} {
    # No access-log directive. Docker logging is disabled in compose.yaml.
    @ingest path /v1/events /healthz
    handle @ingest {
        reverse_proxy collector:8787 {
            header_up -Cookie
            header_up -Authorization
            # Replace any client-supplied value with the address Caddy saw, so
            # the collector's in-memory rate limit is per client. It is never stored.
            header_up X-Forwarded-For {client_ip}
            header_up -X-Real-IP
        }
    }
    handle {
        respond "Not found" 404
    }
}
