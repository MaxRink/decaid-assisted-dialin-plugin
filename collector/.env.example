# Canonical homelab deployment. Remote sharing remains opt-in in the client.
RESEARCH_DOMAIN=dialin-collector.private-testumgebung.de
RESEARCH_ALLOWED_ORIGINS=https://your-user.github.io
RESEARCH_RETENTION_DAYS=30
RESEARCH_MAX_STORAGE_BYTES=268435456
RESEARCH_REQUESTS_PER_MINUTE=60

RESEARCH_MAX_RECORDS=100000

# Optional monitoring overlay requires your own strong unique password:
# RESEARCH_GRAFANA_PASSWORD=replace-with-your-own-long-random-password
