{
  "uid": "decaid-research",
  "title": "Decaid \u00b7 retained espresso research",
  "description": "Private aggregate snapshots of the current retained dataset. Corrections and retention can decrease every series. No user/device/shot identifiers. Never apply rate() to these gauges.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "decaid",
    "research",
    "private"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Decaid research",
          "value": "decaid-research"
        }
      },
      {
        "name": "kind",
        "label": "Observation kind",
        "type": "custom",
        "query": "shot,feedback,advice,setting_change,flow_summary",
        "current": {
          "text": "shot",
          "value": "shot"
        }
      },
      {
        "name": "mode",
        "label": "Evidence mode",
        "type": "custom",
        "query": "manual,measured,practice,replay",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "manual",
            "measured"
          ],
          "value": [
            "manual",
            "measured"
          ]
        }
      },
      {
        "name": "model",
        "label": "Grinder (measurement panels)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(decaid_research_grinder_count, model)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "unit",
        "label": "Coordinate unit (native panels)",
        "type": "custom",
        "query": "dial-marks,micrometres,deci-micrometre,clicks,total-clicks,numbered-settings,micro-ticks,printed-decimal,dial-positions,\u00b5m,\u00b5m (DDD readout only),dial marks,numbered settings,dial micro-ticks,clicks from zero,dial positions",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "dial-marks",
          "value": "dial-marks"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 99,
      "title": "Research exporter availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "If unavailable, stored records and ingestion remain intact; research aggregates are withheld until a scheduled/startup rebuild fits the fixed20,000-series budget. Blank plots are not zero measurements.",
      "targets": [
        {
          "refId": "A",
          "expr": "decaid_research_metrics_available",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNAVAILABLE \u2014 series limit exceeded; records remain stored",
                  "color": "red"
                },
                "1": {
                  "text": "Complete retained research snapshot",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal"
      }
    },
    {
      "id": 1,
      "title": "Retained observations \u2014 all grinders, selected kind/mode",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current retained records, not people or unique grinders. Grinder filter applies only to measurement panels. Corrections replace earlier revisions.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(decaid_research_observations{kind=\"$kind\",mode=~\"$mode\"}) or (decaid_research_retained_records == 0)",
          "legendFormat": "Observations",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Mean pump duration",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"pump_time_seconds\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"pump_time_seconds\"})",
          "legendFormat": "{{mode}} \u00b7 {{model}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Mean measured beverage yield",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"yield_grams\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"yield_grams\"})",
          "legendFormat": "{{mode}} \u00b7 {{model}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Collector storage used",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * decaid_research_storage_bytes / decaid_research_storage_limit_bytes",
          "legendFormat": "Storage",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Pump duration \u2014 retained population over time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Each point is the mean of current retained observations at scrape time. This is not a per-shot event timeline.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "showPoints": "always",
            "lineWidth": 2,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"pump_time_seconds\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"pump_time_seconds\"})",
          "legendFormat": "{{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Pump-duration distribution (p50 / p90)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Quantiles use cumulative gauge buckets directly. Do not apply rate(). Quantiles are bucket estimates, not exact individual times.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "showPoints": "always",
            "lineWidth": 2,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (mode,model,le) (decaid_research_distribution_bucket{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"pump_time_seconds\"}))",
          "legendFormat": "p50 \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (mode,model,le) (decaid_research_distribution_bucket{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"pump_time_seconds\"}))",
          "legendFormat": "p90 \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Dose and yield \u2014 separate gram measurements",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 12,
            "showPoints": "always",
            "lineWidth": 2,
            "pointSize": 5,
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"dose_grams\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"dose_grams\"})",
          "legendFormat": "Dose \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"yield_grams\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"yield_grams\"})",
          "legendFormat": "Yield \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Brew and tasting temperatures",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Missing temperatures are omitted, never replaced by recipe targets.",
