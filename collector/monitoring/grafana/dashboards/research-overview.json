          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"mix_temperature_celsius\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"mix_temperature_celsius\"})",
          "legendFormat": "Mix \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"group_temperature_celsius\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"group_temperature_celsius\"})",
          "legendFormat": "Group \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (mode,model) (decaid_research_measurement_sum{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"tasting_temperature_celsius\"}) / sum by (mode,model) (decaid_research_measurement_count{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",quantity=\"tasting_temperature_celsius\"})",
          "legendFormat": "Tasting \u00b7 {{mode}} \u00b7 {{model}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
