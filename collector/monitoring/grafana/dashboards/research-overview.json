    {
      "id": 11,
      "title": "Taste preference \u2014 current observation counts",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Explicit taste preferences, not an extraction diagnosis. These describe the current shot, not the outcome caused by its next-shot recommendation.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model,value,mode) (decaid_research_categories{kind=\"$kind\",mode=~\"$mode\",model=~\"$model\",field=\"taste_intent\"})",
